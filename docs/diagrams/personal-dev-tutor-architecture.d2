direction: down

vars: {
  d2-config: {
    layout-engine: dagre
    theme-id: 200
    dark-theme-id: 200
    sketch: false
    pad: 40
  }
}

developer: Developer {
  shape: person
  style.fill: "#0f172a"
  style.stroke: "#38bdf8"
  style.font-color: "#e0f2fe"
  style.stroke-width: 3
}

tutor: {
  label: "Personal Dev Tutor — Main Orchestrator"
  direction: right
  style.fill: "#111827"
  style.stroke: "#8b5cf6"
  style.stroke-width: 4
  style.border-radius: 18

  gsd: GSD lifecycle {
    shape: hexagon
    style.fill: "#312e81"
    style.stroke: "#818cf8"
    style.font-color: "#eef2ff"
    style.stroke-width: 3
  }

  gate: Learning gate {
    shape: diamond
    style.fill: "#164e63"
    style.stroke: "#22d3ee"
    style.font-color: "#ecfeff"
    style.stroke-width: 3
  }

  router: Tool + worker router {
    style.fill: "#064e3b"
    style.stroke: "#34d399"
    style.font-color: "#ecfdf5"
    style.stroke-width: 3
    style.border-radius: 10
  }

  verifier: Independent verifier {
    shape: diamond
    style.fill: "#7c2d12"
    style.stroke: "#fb923c"
    style.font-color: "#fff7ed"
    style.stroke-width: 3
  }

  ledger: Learning ledger {
    shape: cylinder
    style.fill: "#581c87"
    style.stroke: "#c084fc"
    style.font-color: "#faf5ff"
    style.stroke-width: 3
  }

  gsd -> gate: bounded phase
  gate -> router: bounded unit
  router -> verifier: evidence required
  verifier -> ledger: mastery evidence
}

delivery: {
  label: "Delegated delivery and durable evidence"
  direction: right
  style.fill: "#0b1220"
  style.stroke: "#334155"
  style.stroke-width: 3
  style.border-radius: 16

  toolkit: {
    label: Public agent-dev-kit
    direction: down
    style.fill: "#3f2100"
    style.stroke: "#f59e0b"
    style.stroke-width: 3
    style.border-radius: 12

    skills: "19 profile capabilities"
    diagrams: "Mermaid + D2"
    quality: "Security · QA · review"
    workstation: "Trusted workstation · network + configured CLIs"
  }

  context: {
    label: "Context intelligence"
    direction: down
    style.fill: "#2e1065"
    style.stroke: "#c084fc"
    style.stroke-width: 3
    style.border-radius: 12

    graphify: "Graphify · local AST cache"
    context7: "Context7 · current library docs"
    evidence: "Exact command evidence · private cache"
    sandbox: "Optional offline verification · untrusted code"
  }

  workers: {
    label: "tmux session: personal"
    direction: down
    style.fill: "#082f49"
    style.stroke: "#38bdf8"
    style.stroke-width: 3
    style.border-radius: 12

    implementer: Codex implementer
    reviewer: Codex reviewer / verifier
  }

  repo: {
    label: Project repository
    direction: down
    style.fill: "#052e16"
    style.stroke: "#4ade80"
    style.stroke-width: 3
    style.border-radius: 12

    planning: .planning/ {
      shape: package
    }
    source: Source + tests {
      shape: document
    }
    decisions: ADRs + learning evidence {
      shape: page
    }
    diagrams: Mermaid + D2 sources {
      shape: page
    }
  }
}

developer -> tutor.gsd: intent + decisions {
  style.stroke: "#38bdf8"
  style.stroke-width: 3
}
tutor.router -> delivery.toolkit: selects proactive capabilities {
  style.stroke: "#f59e0b"
}
tutor.router -> delivery.toolkit.workstation: default execution path {
  style.stroke: "#4ade80"
  style.stroke-width: 3
}
tutor.router -> delivery.context.graphify: architecture + impact context {
  style.stroke: "#c084fc"
}
tutor.router -> delivery.context.context7: current API evidence {
  style.stroke: "#c084fc"
}
tutor.router -> delivery.context.evidence: bounded output preview {
  style.stroke: "#c084fc"
}
tutor.verifier -> delivery.context.sandbox: isolated test evidence {
  style.stroke: "#c084fc"
}
tutor.router -> delivery.workers.implementer: bounded prompt {
  style.stroke: "#34d399"
  style.stroke-width: 3
}
delivery.workers.implementer -> delivery.repo.source: implementation + tests
delivery.workers.reviewer -> delivery.repo.source: independent review {
  style.stroke-dash: 5
}
tutor.verifier -> delivery.repo.source: verifies diff + tests {
  style.stroke: "#fb923c"
  style.stroke-width: 3
}
tutor.gsd -> delivery.repo.planning: authoritative state
tutor.ledger -> delivery.repo.decisions: durable evidence
delivery.toolkit.diagrams -> delivery.repo.diagrams: rendered artifacts {
  style.stroke: "#f59e0b"
}
delivery.repo.source -> delivery.context.graphify: local code-only extraction {
  style.stroke: "#c084fc"
  style.stroke-dash: 5
}
delivery.repo.source -> delivery.context.evidence: exact command output {
  style.stroke: "#c084fc"
  style.stroke-dash: 5
}
delivery.repo.source -> delivery.context.sandbox: explicit trigger · network denied {
  style.stroke: "#c084fc"
  style.stroke-dash: 5
}