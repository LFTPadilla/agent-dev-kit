# Per-host dependencies — never commit. Install after clone.
node_modules/
.venv/
venv/
__pycache__/
*.pyc

# Runtime skills target — third-party skills restored from skills-lock.json, never committed.
.agents/

# Local agent worktrees and overnight run logs — never commit.
.claude/
.gnhf/
/.worktrees/
.worktrees/

# Secrets / local
.env
.env.*
*.local
.DS_Store
.pi/
.kube/
private-overlays/
docs/orchestration-research/

.agent-runs/

# Playwright auth state — holds live session tokens, regenerate per run
playwright/.auth/
test-results/
playwright-report/

# Generated local code-graph output
/graphify-out/

# Calibration bench output — regenerate from evals/calibration/runs/*.json.
# A committed report goes stale and misstates the numbers.
evals/calibration/report.json
evals/calibration/report.md

# OpenClaw/clawhub vendoring artifacts (in case a skill is copied in with them)
.clawhub/
.clawbot/
_meta.json
